# Local operator config for image generation.
# Copy to `.env.images.local` and set your real key there.

OPENROUTER_API_KEY="<server-only-secret>"
OPENROUTER_IMAGE_MODEL="openai/gpt-image-2"

# Must be supported by the chosen model — see
# `curl https://openrouter.ai/api/v1/images/models`.
# `openai/gpt-image-1` supports only 1:1, 3:2, 2:3, and auto.
OPENROUTER_IMAGE_ASPECT_RATIO="4:3"
