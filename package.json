{
    "name": "my2",
    "private": true,
    "workspaces": [
        "packages/*",
        "tests/*",
        "web"
    ],
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "prod": "node scripts/dev.mjs --db prod",
        "db:init": "node scripts/db.mjs init",
        "db:list": "node scripts/db.mjs list",
        "db:reset": "node scripts/db.mjs reset",
        "db:copy": "node scripts/db.mjs copy",
        "generate:images": "node scripts/generate-blueprint-images.mjs",
        "lint": "eslint .",
        "format": "prettier --write .",
        "typecheck": "tsc --noEmit",
    "validate:mystery-structure": "node scripts/validate-mystery-structure.mjs",
    "validate:clue-graph": "node scripts/validate-clue-graph.mjs",
    "trails:clue-graph": "node scripts/print-clue-graph-trails.mjs",
        "check:doc-refs": "node scripts/check-doc-refs.mjs",
        "check:word-budgets": "node scripts/check-word-budgets.mjs",
        "check:gate-coverage": "node scripts/check-gate-coverage.mjs",
        "check:tracked-files": "node scripts/check-tracked-files.mjs",
        "check:coverage-floors": "node scripts/check-coverage-floors.mjs",
        "check:quality": "node scripts/check-quality.mjs",
        "check:imports": "node scripts/check-imports.mjs",
        "test:unit": "vitest run tests/api/unit",
        "test:integration": "node scripts/run-mock-tests.mjs integration",
        "test:e2e": "node scripts/run-mock-tests.mjs e2e",
        "test:golden:record": "GOLDEN_RECORD=1 node scripts/run-mock-tests.mjs e2e",
        "test:integration:live": "node scripts/run-live-ai.mjs integration",
        "test:e2e:live": "node scripts/run-live-ai.mjs e2e",
        "test:gate": "node scripts/run-test-gate.mjs",
        "test:snapshots:record": "EVAL_SNAPSHOT_RECORD=1 vitest run tests/api/unit/eval-snapshots.test.ts",
        "test:unit:coverage": "vitest run tests/api/unit --coverage",
        "test": "node scripts/run-test-gate.mjs"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "24.13.3",
        "@vitest/coverage-v8": "4.1.11",
        "dependency-cruiser": "18.7.2",
        "eslint": "10.9.1",
        "eslint-plugin-sonarjs": "4.2.2",
        "globals": "17.14.0",
        "playwright": "1.62.1",
        "prettier": "3.9.6",
        "typescript": "5.9.3",
        "typescript-eslint": "8.68.0",
        "vitest": "4.1.11"
    }
}
